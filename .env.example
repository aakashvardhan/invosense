# Composio
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default
COMPOSIO_GMAIL_AUTH_CONFIG_ID=

# Custom Gmail OAuth (optional — use your Google Cloud credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
